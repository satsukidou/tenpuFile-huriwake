/**
 * 仕様：
 * - 検索：今月1日以降（after:YYYY/MM/01）
 * - 件名キーワードで添付を共有フォルダへ保存
 * - 送信者へCCなしで受領確認（送信枠を確認）
 * - 保存できたらスレッドに「添付ファイル保存済み」ラベル
 * - 二重処理防止：messageId を ScriptProperties に記録（スター不使用）
 * - ②ログ：スプレッドシートに保存結果を追記
 */
function saveAttachments_fromThisMonth_threadLabel_replyNotify_withLog() {
  // ===== 設定 =====
  const recipient = "plazakenkyukai@gmail.com";
  const doneLabelName = "添付ファイル保存済み";

  // ★ログ用スプレッドシートID（最初に作ってIDを貼る）
  const LOG_SHEET_ID = "180CtfuH13kYNYYi5u8_DygNFMpLLwHLaOAF64GewJY0";
  const LOG_TAB_NAME = "log";

  const rules = [
    { keyword: "報告", folderName: "年度当初報告", folderId: "1FLLUzXkc2gnG7af8e5LWs2gwPra6Ms_i" },
    { keyword: "会報", folderName: "会報紀要",   folderId: "1B8vME6pm7FjNzQsuO55vR2apxqbC7-h4" },
    { keyword: "論文", folderName: "教育論文",   folderId: "1-TMQzemKYkRrP0GqVqe82AeJ8w6WYRFR" }
  ];
  const defaultFolder = { folderName: "未分類", folderId: "1lt9DXVGB-Pe7HskWT3Q8ZA5Tz4SSO17P" };
  // ==============

  const tz = Session.getScriptTimeZone() || "Asia/Tokyo";
  const doneLabel = GmailApp.getUserLabelByName(doneLabelName) || GmailApp.createLabel(doneLabelName);
  const props = PropertiesService.getScriptProperties();
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) { Logger.log("別の処理が実行中です"); return; }
  try {
  const logSheet = getOrInitLogSheet_(LOG_SHEET_ID, LOG_TAB_NAME);

  // 「今月1日以降」だと昨日のメールが除外されるため、直近30日で拾う
  const recentCutoff = new Date();
  recentCutoff.setDate(recentCutoff.getDate() - 30);
  recentCutoff.setHours(0, 0, 0, 0);

  // Gmail 検索は条件の解釈がズレやすいため、広く拾ってから実際の宛先・日付で絞る
  const threads = GmailApp.search("has:attachment in:anywhere newer_than:30d");

  if (!threads || threads.length === 0) {
    Logger.log("対象メールなし: has:attachment in:anywhere newer_than:30d");
    return;
  }

  for (const thread of threads) {
    let savedSomethingInThisThread = false;

    const messages = thread.getMessages();
    for (const message of messages) {
      const msgId = message.getId();

      // 重複処理防止（messageId）
      if (props.getProperty("done_" + msgId)) continue;

      const d = message.getDate ? message.getDate() : new Date();
      if (!matchesRecipient_(message, recipient)) continue;
      if (d < recentCutoff) continue;

      const fromRaw = message.getFrom() || "(送信者不明)";
      const subject = message.getSubject() || "(件名なし)";

      try {
        const attachments = message.getAttachments({ includeInlineImages: false });
        if (!attachments || attachments.length === 0) continue;

        // 保存状態を先に記録。返信失敗時にファイルを再保存しない。
        const savedKey = "saved_" + msgId;
        let savedState = props.getProperty(savedKey);
        let dest, savedNames;
        if (savedState) {
          const state = JSON.parse(savedState);
          dest = { folderName: state.folderName, folderId: state.folderId };
          savedNames = state.savedNames;
        } else {
          dest = pickDestination_(subject, rules, defaultFolder);
          const folder = DriveApp.getFolderById(dest.folderId);
          savedNames = [];
          for (const att of attachments) {
            // 作成直後に進捗を保存し、途中失敗での再作成を減らす。
            const file = folder.createFile(att);
            savedNames.push(file.getName());
            props.setProperty(savedKey, JSON.stringify({
              folderName: dest.folderName, folderId: dest.folderId,
              savedNames: savedNames, complete: false
            }));
          }
          props.setProperty(savedKey, JSON.stringify({
            folderName: dest.folderName, folderId: dest.folderId,
            savedNames: savedNames, complete: true
          }));
        }
        // 途中で保存失敗した場合は自動返信せず、手動確認が必要。
        const state = JSON.parse(props.getProperty(savedKey));
        if (!state.complete) {
          throw new Error("添付ファイルの一部保存済み。重複防止のため手動確認が必要");
        }

        const remaining = MailApp.getRemainingDailyQuota();
        if (remaining < 1) {
          Logger.log("送信可能枠がないため処理を終了します");
          return;
        }
        const mail = buildReplyBody_({
          fromRaw, subject, date: d,
          folderName: dest.folderName, savedNames
        });
        // CCなし。送信成功後に処理済み記録。
        message.reply(mail.body, {
          name: "茨城県教育研究会 事務局（自動送信）"
        });
        props.setProperty("done_" + msgId, new Date().toISOString());
        savedSomethingInThisThread = true;

        // スレッドにラベル付与（成功したメールがあれば付ける）
        if (!thread.getLabels().some(label => label.getName() === doneLabelName)) {
          thread.addLabel(doneLabel);
        }

        // ②ログ：成功
        appendLog_(logSheet, tz, {
          status: "OK",
          messageId: msgId,
          threadId: thread.getId(),
          mailDate: d,
          from: fromRaw,
          subject,
          folderName: dest.folderName,
          fileNames: savedNames.join(" / "),
          note: ""
        });

      } catch (e) {
        // ②ログ：失敗（※失敗時は done_ を付けない＝次回再処理できる）
        appendLog_(logSheet, tz, {
          status: "ERROR",
          messageId: msgId,
          threadId: thread.getId(),
          mailDate: d,
          from: fromRaw,
          subject,
          folderName: "",
          fileNames: "",
          note: (e && e.message) ? e.message : String(e)
        });
        if (String(e).includes("Service invoked too many times for one day: email")) return;
      }
    }

    // スレッドにラベル（見える管理）
    if (savedSomethingInThisThread) {
      const labels = thread.getLabels ? thread.getLabels() : [];
      const hasDoneLabel = labels.some(label => label.getName() === doneLabelName);
      if (!hasDoneLabel) {
        thread.addLabel(doneLabel);
      }
    }
  }
  } finally { lock.releaseLock(); }
}

/** 今月1日（yyyy/MM/dd） */
function getFirstDayOfThisMonthStr_() {
  const tz = Session.getScriptTimeZone() || "Asia/Tokyo";
  const now = new Date();
  const y = Number(Utilities.formatDate(now, tz, "yyyy"));
  const m = Number(Utilities.formatDate(now, tz, "MM"));
  const firstDay = new Date(y, m - 1, 1, 0, 0, 0);
  return Utilities.formatDate(firstDay, tz, "yyyy/MM/dd");
}

/** 実際の To/Cc に recipient が含まれるか */
function matchesRecipient_(message, recipient) {
  const target = String(recipient || "").trim().toLowerCase();
  if (!target) return false;

  const haystack = [
    message.getTo() || "",
    message.getCc() || "",
    message.getReplyTo() || ""
  ].join(" ").toLowerCase();

  return haystack.indexOf(target) !== -1;
}

/** 件名から保存先を決める（優先順） */
function pickDestination_(subject, rules, defaultFolder) {
  const normalizedSubject = String(subject || "").trim().toLowerCase();

  for (const r of rules) {
    const keyword = String(r.keyword || "").trim().toLowerCase();
    if (!keyword) continue;
    if (normalizedSubject.includes(keyword)) return r;
  }
  return defaultFolder;
}

/** 返信本文（受領確認）を作る */
function buildReplyBody_(params) {
  const tz = Session.getScriptTimeZone() || "Asia/Tokyo";
  const receivedAt = Utilities.formatDate(params.date || new Date(), tz, "yyyy/MM/dd HH:mm");
  const safeSavedNames = Array.isArray(params.savedNames) ? params.savedNames.filter(Boolean) : [];
  const fileLines = safeSavedNames.length > 0
    ? safeSavedNames.map(n => `・${n}`).join("\n")
    : "（保存されたファイルはありません）";

  return {
    body:
`${params.fromRaw} 様

常日頃より大変お世話になっております。

以下のメールにつきまして、添付ファイルを正常に受領し、共有フォルダへ保存いたしました。
本メールは自動送信による受領確認です。

――――――――――
■ 対象メール
件名：${params.subject}
受領日時：${receivedAt}

■ 保存先
${params.folderName}

■ 保存したファイル
${fileLines}
――――――――――

内容に不備等がございましたら、改めてご連絡させていただく場合がございます。
この自動返信プログラムは、生成AIを活用して作成しました。

今後ともよろしくお願いいたします。

――――――――――
茨城県教育研究会 事務局主幹 豊田雅之
――――――――――
`
  };
}

/** ログ用シート取得＆ヘッダ初期化 */
function getOrInitLogSheet_(spreadsheetId, tabName) {
  const ss = SpreadsheetApp.openById(spreadsheetId);
  const sheet = ss.getSheetByName(tabName) || ss.insertSheet(tabName);

  if (sheet.getLastRow() === 0) {
    sheet.appendRow([
      "loggedAt",
      "status",
      "messageId",
      "threadId",
      "mailDate",
      "from",
      "subject",
      "folderName",
      "fileNames",
      "note"
    ]);
  }
  return sheet;
}

/** ログ追記 */
function appendLog_(sheet, tz, row) {
  const logDate = row.mailDate instanceof Date ? row.mailDate : new Date();
  const safeRow = {
    status: row.status || "",
    messageId: row.messageId || "",
    threadId: row.threadId || "",
    from: row.from || "",
    subject: row.subject || "",
    folderName: row.folderName || "",
    fileNames: row.fileNames || "",
    note: row.note || ""
  };

  sheet.appendRow([
    Utilities.formatDate(new Date(), tz, "yyyy/MM/dd HH:mm:ss"),
    safeRow.status,
    safeRow.messageId,
    safeRow.threadId,
    Utilities.formatDate(logDate, tz, "yyyy/MM/dd HH:mm:ss"),
    safeRow.from,
    safeRow.subject,
    safeRow.folderName,
    safeRow.fileNames,
    safeRow.note
  ]);
}
